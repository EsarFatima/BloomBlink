{
  "version": 2,
  "buildCommand": "cd frontend/storefront && npm ci && npm run build",
  "outputDirectory": "frontend/storefront/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://bloomblink.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}